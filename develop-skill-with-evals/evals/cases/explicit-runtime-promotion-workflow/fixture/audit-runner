#!/usr/bin/env python3
import json
from pathlib import Path
import subprocess
import sys


with Path("runner-invocations.jsonl").open("a", encoding="utf-8") as stream:
  stream.write(json.dumps(sys.argv[1:]) + "\n")
runner = (
  Path(".agents")
  / "skills"
  / "develop-skill-with-evals"
  / "scripts"
  / "run_skill_evals.py"
)
completed = subprocess.run([sys.executable, str(runner), *sys.argv[1:]], check=False)
raise SystemExit(completed.returncode)
