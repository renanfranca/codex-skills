#!/usr/bin/env python3
import json
import os
from pathlib import Path
import sys


log = Path(os.environ["AUDIT_RUNTIME_LOG"])
with log.open("a", encoding="utf-8") as stream:
  stream.write(json.dumps(sys.argv[1:]) + "\n")

schema = Path(sys.argv[sys.argv.index("--output-schema") + 1])
output = Path(sys.argv[sys.argv.index("-o") + 1])
workspace = Path(sys.argv[sys.argv.index("-C") + 1])
if "judge" in schema.name:
  response = {"verdict": "PASS", "rationale": "observable", "evidence": ["fixture"]}
else:
  if os.environ.get("AUDIT_RUNTIME_MECHANICAL_FAILURE") != "1":
    (workspace / "result.txt").write_text("ok", encoding="utf-8")
  response = {
    "summary": "done",
    "classification": "test",
    "evidence": [],
    "files_changed": ["result.txt"]
  }
output.write_text(json.dumps(response), encoding="utf-8")
