#!/usr/bin/env python3
import json
from pathlib import Path
import sys


output = Path(sys.argv[sys.argv.index("-o") + 1])
workspace = Path(sys.argv[sys.argv.index("-C") + 1])
schema = Path(sys.argv[sys.argv.index("--output-schema") + 1])
if "judge" in schema.name:
  response = {"verdict": "PASS", "rationale": "mechanical fixture", "evidence": []}
else:
  marker = next((workspace / ".agents" / "skills").glob("*/marker.txt"))
  if marker.read_text(encoding="utf-8") == "candidate":
    (workspace / "result.txt").write_text("ok", encoding="utf-8")
  response = {
    "summary": "fixture",
    "classification": "test",
    "evidence": [],
    "files_changed": ["result.txt"],
  }
output.write_text(json.dumps(response), encoding="utf-8")
print(json.dumps({
  "type": "turn.completed",
  "usage": {
    "input_tokens": 10,
    "cached_input_tokens": 2,
    "output_tokens": 4
  }
}))
