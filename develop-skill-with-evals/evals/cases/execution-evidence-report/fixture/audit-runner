#!/usr/bin/env python3
from pathlib import Path
import subprocess
import sys


runner = (
  Path(".agents")
  / "skills"
  / "develop-skill-with-evals"
  / "scripts"
  / "run_skill_evals.py"
)
completed = subprocess.run([sys.executable, str(runner), *sys.argv[1:]], check=False)
raise SystemExit(completed.returncode)
