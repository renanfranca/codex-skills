{
  "name": "codex-skills",
  "version": "0.0.0",
  "private": true,
  "description": "Codex Skills",
  "license": "UNLICENSED",
  "scripts": {
    "prebuild": "npm run evidence:validate && npm run evidence:generate",
    "build": "vitepress build",
    "predev": "npm run evidence:validate && npm run evidence:generate",
    "dev": "vitepress",
    "evidence:generate": "node scripts/generate-content.mjs --repository-root .. --archive ../evaluation-reports --output .generated",
    "evidence:validate": "cd .. && python3 -B develop-skill-with-evals/scripts/manage_evaluation_archive.py validate --archive evaluation-reports",
    "prepare": "cd .. && husky website/.husky",
    "prettier:check": "prettier --check .",
    "prettier:format": "prettier --write .",
    "preview": "vitepress preview",
    "test": "node --test",
    "test:e2e": "bash scripts/run-playwright-container.sh",
    "test:e2e:direct": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@prettier/plugin-xml": "3.4.2",
    "husky": "9.1.7",
    "lint-staged": "17.0.8",
    "prettier": "3.9.5",
    "prettier-plugin-gherkin": "4.0.0",
    "prettier-plugin-java": "2.10.2",
    "prettier-plugin-organize-imports": "4.3.0",
    "prettier-plugin-packagejson": "3.0.2",
    "vitepress": "1.6.4",
    "vue": "3.5.40"
  },
  "packageManager": "npm@11.7.0",
  "engines": {
    "node": ">=24"
  }
}
